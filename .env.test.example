# ========== 测试数据库 ==========
# 使用独立数据库文件，绝不碰生产库 ./data/dev.db
DATABASE_URL="file:/app/data/test.db"

# ========== NextAuth（测试占位）==========
NEXTAUTH_SECRET="test-secret-do-not-use-in-prod"

# ========== AI 配置（占位，prisma generate 需要）==========
AI_PROVIDER="openai"
OPENAI_API_KEY="sk-test-placeholder"
OPENAI_BASE_URL="https://api.deepseek.com/v1"
OPENAI_MODEL="deepseek-chat"

# ========== Stage 3: 豆包图像识别 + 语音转写（占位）==========
# 生产环境使用真实 Key（只放 .env，不入 git）
VOLCENGINE_API_KEY="test-placeholder"
VOLCENGINE_BASE_URL="https://ark.cn-beijing.volces.com/api/v3"
# VLM 图像识别（doubao-seed-2-0-pro）
PRO_ENDPOINT_ID=""
PRO_MODEL_NAME="doubao-seed-2-0-pro-260215"
# ASR 语音转写（doubao-seed-2-0-lite）
LITE_ENDPOINT_ID=""
LITE_MODEL_NAME="doubao-seed-2-0-lite-260215"

# ========== 日志 ==========
LOG_LEVEL="error"
