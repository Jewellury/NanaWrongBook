# E2E Smoke Test 环境变量模板
#
# ⚠️ 安全铁律：真实凭证只能放在 .env.e2e.local（已被 .gitignore 排除）
#             或 GitHub Secrets 中，绝不提交到 git。
#
# 使用方法：
# 1. cp .env.e2e.example .env.e2e.local
# 2. 在 .env.e2e.local 中填入真实值
# 3. 运行 Smoke test 前手动 export 或用 dotenv 加载：
#    node -r dotenv/config npx playwright test --project=smoke
#    （Playwright 不会自动加载 .env.e2e.local，需自行 export 或用 dotenv）

# 生产 Smoke Test 专用测试账号
E2E_SMOKE_EMAIL=
E2E_SMOKE_PASSWORD=

# 目标环境 URL（Smoke test 用）
# 本地调试：http://127.0.0.1:3000
# 生产环境：https://nana.nanatop.xyz
E2E_BASE_URL=https://nana.nanatop.xyz
